{
  "name": "wenyao",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:all": "concurrently -n \"worker,pages\" -c \"blue,green\" \"npm run dev\" \"npm --prefix pages run dev\"",
    "build": "npm --prefix pages run build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx scripts/replay.ts",
    "migrate:mongodb": "tsx scripts/migrate-from-mongodb.ts",
    "db:migrate:local": "wrangler d1 migrations apply wenyao --local",
    "db:migrate:remote": "wrangler d1 migrations apply wenyao --remote",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "lint": "eslint \"src/**/*.{ts,js}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,js}\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.4",
    "hono": "^4.10.4",
    "zod": "^4.1.12",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "mongodb": "^7.0.0",
    "wrangler": "^4.0.0",
    "@cloudflare/vitest-plugin": "^1.4.8"
  }
}
