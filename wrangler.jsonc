{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wenyao",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wenyao",
      "database_id": "d6e78b8e-643a-4a08-9b86-4d4e8d6e1997",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "wenyao-recordings" }],
  "durable_objects": {
    "bindings": [{ "name": "CONCURRENCY", "class_name": "BackendConcurrency" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BackendConcurrency"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "pages/build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/admin/*", "/v1/*", "/health"],
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
